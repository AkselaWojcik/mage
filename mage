#!/usr/bin/env ruby
# frozen_string_literal: true

# mage: keep Claude session contexts per git repo and branch, outside the repo.
#
# Terms
#   chat     a named container of versions, usually one per git branch
#   version  one snapshot of a chat's context file
#   context  the chat@version currently loaded into the repo
#
# Storage outside the repo
#   ~/.mage/config.json                               global settings
#   ~/.mage/repos/<repo>-<hash>/mage.json             chats, versions, defaults
#   ~/.mage/repos/<repo>-<hash>/chats/<cid>/<vid>.md  version contents
#   ~/.mage/repos/<repo>-<hash>/trash/                removed and discarded files
#
# Inside the repo (untracked, listed in .git/info/exclude)
#   .mage/CONTEXT.md    the file Claude reads and edits
#   .mage/current.json  which chat@version CONTEXT.md belongs to, plus the hash
#                       of the stored version at load time
#
# Safety rules
#   - current.json, never the git branch, decides where CONTEXT.md is saved.
#   - A CONTEXT.md without current.json is never overwritten.
#   - Saving refuses when the stored version changed since loading (--force overrides).
#   - Every write is atomic (temp file + rename) and one command runs per repo at a time.
#   - Nothing is deleted for good: removed and discarded files go to the trash.
#
# The help text is in help.txt, next to this script.

require "digest"
require "fileutils"
require "json"
require "time"

class MageError < StandardError; end

class Mage
  MAGE_HOME = File.expand_path(ENV.fetch("MAGE_HOME", "~/.mage"))
  DEFAULT_BIN_DIR = File.expand_path("~/.local/bin")
  CONTEXT_DIR = ".mage"
  BRANCH = "__branch"
  DEFAULT = "__default"

  # command => one-letter shortcut (nil: no shortcut)
  TOP_COMMANDS = {
    "install" => nil, "init" => "i", "help" => "h", "status" => nil,
    "revive" => "r", "jumpstart" => "j", "new" => "n", "load" => "l", "save" => "s", "quit" => "q", "discard" => "d",
    "message" => "m", "chat" => "c", "version" => "v"
  }.freeze
  CHAT_COMMANDS = { "list" => "l", "switch" => "s", "new" => "n", "delete" => "d" }.freeze
  VERSION_COMMANDS = CHAT_COMMANDS.merge("fork" => "f", "pin" => "p").freeze

  DEFAULT_MESSAGE = <<~TEXT.strip
    Read {file} (in the repository root). It holds the context of my earlier work \
    on this task. This session is called {context} (chat@version); use that name \
    whenever you refer to this session or its context. Read the file carefully, then \
    reply with a short summary of where we are and wait for my instructions. Do not \
    edit files or run commands yet. Later, when I ask you to update the context, \
    rewrite {file} so that a fresh session could continue from it with no other information.
  TEXT

  HELP_FILE = File.join(File.dirname(File.realpath(__FILE__)), "help.txt")

  # Tried in order by `mage revive` to copy the prompt (macOS, Wayland, X11).
  CLIPBOARD_TOOLS = [
    %w[pbcopy], %w[wl-copy], %w[xclip -selection clipboard], %w[xsel --clipboard --input]
  ].freeze

  def self.main(argv)
    new(argv).run
  rescue MageError => e
    warn "mage: #{e.message}"
    exit 1
  rescue Interrupt
    warn "\nmage: interrupted"
    exit 130
  end

  def initialize(argv)
    flags, @args = argv.partition { |arg| arg.start_with?("-") }
    unknown = flags - %w[-f --force -h --help]
    raise MageError, "unknown option: #{unknown.first} (see: mage help)" if unknown.any?

    @force = flags.include?("-f") || flags.include?("--force")
    @help = flags.include?("-h") || flags.include?("--help")
  end

  def run
    return puts(help_text) if @help

    command = resolve_command(@args.shift, TOP_COMMANDS, "mage") || "status"
    case command
    when "help" then puts(help_text)
    when "install" then install(*args(1))
    else
      require_installed!
      with_repo_lock { run_repo_command(command) }
    end
  end

  private

  # ---------------------------------------------------------------------------
  # Command dispatch
  # ---------------------------------------------------------------------------

  def run_repo_command(command)
    args(0) unless %w[revive jumpstart load new chat version].include?(command) # the rest take no arguments
    case command
    when "init" then init
    when "status" then status
    when "revive" then revive(*args(1))
    when "jumpstart" then jumpstart(*args(1))
    when "load" then load_chat(*args(1))
    when "new" then new_chat(*args(1))
    when "save" then save
    when "quit" then quit
    when "discard" then discard
    when "message" then message
    when "chat" then chat_command(resolve_command(@args.shift, CHAT_COMMANDS, "mage chat") || "list")
    when "version" then version_command(resolve_command(@args.shift, VERSION_COMMANDS, "mage version") || "list")
    end
  end

  def chat_command(sub)
    args(0) if sub == "list"
    case sub
    when "list" then chat_list
    when "switch"
      name, version = args(2)
      cid = find_chat(name)
      switch_to(cid, find_version(cid, version))
    when "new" then new_chat(*args(1))
    when "delete"
      name, = args(1)
      raise MageError, "say which chat to delete: mage chat delete <name|cid>" unless name

      chat_delete(find_chat(name))
    end
  end

  def version_command(sub)
    args(0) if sub == "list"
    case sub
    when "list" then version_list(current_chat)
    when "switch"
      ref, = args(1)
      cid = current_chat
      switch_to(cid, find_version(cid, ref))
    when "new"
      name, = args(1)
      cid = current_chat
      save_current! # fails on a conflict before anything is created
      switch_to(cid, create_version(cid, name, starter_content(meta["chats"][cid]["name"])))
    when "fork"
      name, = args(1)
      version_fork(current_chat, name)
    when "pin"
      ref, = args(1)
      raise MageError, "say which version to pin: mage version pin <name|vid>" unless ref

      version_pin(current_chat, ref)
    when "delete"
      ref, = args(1)
      raise MageError, "say which version to delete: mage version delete <name|vid>" unless ref

      cid = current_chat
      version_delete(cid, find_version(cid, ref))
    end
  end

  # Accepts a full command name or its one-letter shortcut.
  def resolve_command(word, commands, prefix)
    return nil if word.nil?
    return word if commands.key?(word)

    full, = commands.find { |_, letter| letter == word }
    full or raise MageError, "unknown command: #{prefix} #{word} (see: mage help)"
  end

  # Takes up to `max` positional arguments, refusing extra ones so that a typo
  # like `mage chat new my chat` doesn't silently do something else.
  def args(max)
    raise MageError, "too many arguments: #{@args.drop(max).join(' ')}" if @args.size > max

    Array.new(max) { |i| @args[i] }.tap { @args.clear }
  end

  # ---------------------------------------------------------------------------
  # Top-level commands
  # ---------------------------------------------------------------------------

  def install(bin_dir = nil)
    bin_dir = File.expand_path(bin_dir || DEFAULT_BIN_DIR)
    script = File.realpath(__FILE__)
    link = File.join(bin_dir, "mage")

    FileUtils.mkdir_p(bin_dir)
    if File.symlink?(link)
      target = File.expand_path(File.readlink(link), bin_dir)
      if target != script
        raise MageError, "#{link} already points to #{target}; re-run with --force to replace it" unless @force

        File.delete(link)
      end
    elsif File.exist?(link)
      raise MageError, "#{link} exists and is not a symlink; move it away first"
    end
    File.symlink(script, link) unless File.symlink?(link)
    File.chmod(0o755, script) unless File.executable?(script)

    FileUtils.mkdir_p(File.join(MAGE_HOME, "repos"))
    # Starts empty, so the built-in DEFAULT_MESSAGE is used until you add a "message" key.
    atomic_write(config_path, "{}\n") unless File.exist?(config_path)

    puts "Installed: #{link} -> #{script}"
    puts "Data dir:  #{MAGE_HOME}"
    warn "note: #{HELP_FILE} is missing, so `mage help` won't work; keep it next to the script" unless File.exist?(HELP_FILE)
    return if ENV["PATH"].to_s.split(":").map { |dir| File.expand_path(dir) }.include?(bin_dir)

    warn "note: #{bin_dir} is not in your PATH; add it to use `mage` directly"
  end

  # Creates the repo's store (if needed) and a chat for the current branch,
  # then loads it. Errors when the branch already has a chat.
  def init
    if File.exist?(meta_path)
      puts "Repo already initialized (#{store_dir})"
    else
      create_repo_store
    end

    name = branch
    raise MageError, "branch '#{name}' already has a chat; run `mage load` to load it" if chat_named(name)

    new_chat(name)
  end

  # `mage revive`: everything needed to start a Claude session on this branch.
  # Load, then show the status and the prompt, and copy the prompt to the
  # clipboard. If loading fails (e.g. a conflict), it stops there, before
  # printing or copying a prompt for the wrong context.
  def revive(ref = nil)
    load_chat(ref)
    puts
    status
    puts
    message
    puts
    puts(copy_to_clipboard(prompt_text) ? "(prompt copied to clipboard)" : "(no clipboard tool found; copy the prompt above)")
  end

  # `mage jumpstart`: a quiet revive. Never asks anything (the branch's chat is
  # created if missing) and never touches the clipboard. It prints only the
  # prompt when loading succeeded, or only the error when it didn't, so
  # `mage jumpstart | pbcopy` copies exactly the prompt.
  def jumpstart(ref = nil)
    quietly { load_chat(ref, ask: false) }
    message
  end

  # Saves whatever is loaded and loads the chat (default: the branch's chat)
  # at its default version. Offers to set up the repo and create the branch's
  # chat when missing (ask: false creates them without asking). A chat named
  # explicitly is never created, so a typo can't make a stray chat.
  def load_chat(ref = nil, ask: true)
    from_branch = ref.nil? || ref == BRANCH
    name = from_branch ? branch : ref
    if from_branch && !File.exist?(meta_path)
      confirm!("mage isn't set up for this repo yet. Set it up with a chat for '#{name}'?", default_yes: true) if ask
      return init
    end

    cid = meta["chats"].key?(name) ? name : chat_named(name)
    return switch_to(cid, find_version(cid, DEFAULT)) if cid
    raise MageError, "no chat '#{name}' (see: mage chat list, or create it: mage new #{name})" unless from_branch

    confirm!("Branch '#{name}' has no chat yet. Create it?", default_yes: true) if ask
    new_chat(name)
  end

  # Creates a chat (default: named after the branch) and loads it.
  # Sets up the repo first if needed: asking for a chat is explicit enough.
  def new_chat(name = nil)
    name = branch if name.nil? || name == BRANCH
    create_repo_store unless File.exist?(meta_path)
    save_current! # fails on a conflict before anything is created
    cid, vid = create_chat(name)
    switch_to(cid, vid)
  end

  def status
    puts "repo:    #{repo_root}"
    puts "branch:  #{current_branch || '(detached HEAD)'}"
    unless File.exist?(meta_path)
      puts "mage:    not initialized for this repo (run: mage init)"
      return
    end

    ptr = pointer
    has_file = File.exist?(context_file)
    if ptr.nil?
      puts "context: none loaded"
      puts "warning: #{rel(context_file)} exists but isn't managed by mage" if has_file
      puts "hint:    run `mage revive`" unless has_file
      return
    end

    puts "context: #{label(ptr['chat'], ptr['version'])}  [#{ptr['chat']}/#{ptr['version']}]"
    stored_path = version_path(ptr["chat"], ptr["version"])
    if !has_file
      puts "warning: #{rel(context_file)} is missing (restore it, or run `mage discard`)"
    elsif !File.exist?(stored_path)
      puts "warning: this version no longer exists in the store"
    else
      stored = File.binread(stored_path)
      puts "changes: #{File.binread(context_file) == stored ? 'none' : 'unsaved changes'}"
      puts "warning: stored version changed since it was loaded (save needs --force)" if digest(stored) != ptr["hash"]
    end
    note_other_branch(ptr)
  end

  def save
    ptr = loaded_context or raise MageError, "nothing is loaded"
    note_other_branch(ptr)
    name = label(ptr["chat"], ptr["version"])
    puts(save_loaded(ptr) ? "Saved #{name}" : "No changes to save in #{name}")
  end

  def quit
    ptr = loaded_context or raise MageError, "nothing is loaded"
    note_other_branch(ptr)
    name = label(ptr["chat"], ptr["version"])
    saved = save_loaded(ptr)
    unload!
    puts "#{saved ? 'Saved' : 'No changes in'} #{name}; removed #{rel(context_file)}"
  end

  # Unloads without saving. CONTEXT.md is moved to the trash, not deleted.
  def discard
    ptr = pointer
    has_file = File.exist?(context_file)
    raise MageError, "nothing is loaded" if ptr.nil? && !has_file

    trashed = nil
    if has_file
      name = ptr ? label(ptr["chat"], ptr["version"]) : "unmanaged file"
      confirm!("Discard unsaved changes in #{rel(context_file)} (#{name})?") if unsaved_changes?(ptr)
      trashed = move_to_trash(context_file, "discarded-#{ptr ? slug(name) : 'unmanaged'}")
    end
    unload!
    puts "Discarded#{" (a copy is in #{trashed})" if trashed}"
  end

  def message
    puts prompt_text
  end

  def prompt_text
    ptr = loaded_context or raise MageError, "nothing is loaded; run `mage load` first"
    template = config.fetch("message", DEFAULT_MESSAGE)
    template.gsub("{file}", rel(context_file)).gsub("{context}", label(ptr["chat"], ptr["version"]))
  end

  # ---------------------------------------------------------------------------
  # Chat and version commands
  # ---------------------------------------------------------------------------

  def chat_list
    chats = meta["chats"]
    return puts("No chats yet (create one: mage load, or mage new <name>)") if chats.empty?

    loaded = pointer&.fetch("chat")
    rows = chats.map do |cid, chat|
      [loaded == cid ? "*" : " ", cid, chat["name"], chat["versions"].size.to_s, label(cid, chat["default"])]
    end
    print_table(["", "ID", "NAME", "VERSIONS", "DEFAULT"], rows)
  end

  def chat_delete(cid)
    chat = meta["chats"][cid]
    ensure_not_loaded!(cid)
    confirm!("Delete chat '#{chat['name']}' and its #{chat['versions'].size} version(s)?")

    # Update metadata first: a crash afterwards only leaves an orphan
    # directory, never metadata pointing at missing files.
    meta["chats"].delete(cid)
    save_meta!
    trashed = move_to_trash(File.join(store_dir, "chats", cid), "chat-#{slug(chat['name'])}")
    atomic_write(File.join(trashed, "chat.json"), JSON.pretty_generate(cid => chat) + "\n")
    puts "Deleted chat '#{chat['name']}' (moved to #{trashed})"
  end

  def version_list(cid)
    chat = meta["chats"][cid]
    loaded = pointer
    puts "Chat '#{chat['name']}' [#{cid}]"
    rows = chat["versions"].map do |vid, version|
      is_loaded = loaded && loaded["chat"] == cid && loaded["version"] == vid
      [is_loaded ? "*" : " ", vid, version["name"] == vid ? "" : version["name"], Time.parse(version["created_at"]).strftime("%Y-%m-%d %H:%M"),
       chat["default"] == vid ? "default" : ""]
    end
    print_table(["", "ID", "NAME", "CREATED", ""], rows)
  end

  # Copies the current version (with unsaved changes saved first) into a new
  # version and switches to it. Handy as a backup before big changes.
  def version_fork(cid, name)
    ptr = save_current!
    source = ptr ? ptr["version"] : find_version(cid, DEFAULT)
    vid = create_version(cid, name, File.binread(version_path(cid, source)))
    puts "Forked #{label(cid, source)} into #{label(cid, vid)}"
    switch_to(cid, vid)
  end

  # Makes a version the chat's default by hand: the one `load`, `revive` and
  # `jumpstart` pick. (New and forked versions become the default on their own.)
  def version_pin(cid, ref)
    vid = find_version(cid, ref)
    meta["chats"][cid]["default"] = vid
    save_meta!
    puts "Pinned #{label(cid, vid)}: it's now the default that `mage load` picks"
  end

  def version_delete(cid, vid)
    chat = meta["chats"][cid]
    ptr = pointer
    if ptr && ptr["chat"] == cid && ptr["version"] == vid
      raise MageError, "#{label(cid, vid)} is loaded; switch to another version or `mage quit` first"
    end
    raise MageError, "can't delete the only version of a chat; delete the chat instead" if chat["versions"].size == 1

    name = label(cid, vid)
    confirm!("Delete version #{name}?")
    chat["versions"].delete(vid)
    chat["default"] = chat["versions"].keys.max_by { |id| id.delete_prefix("v").to_i } if chat["default"] == vid
    save_meta!

    path = version_path(cid, vid)
    trashed = move_to_trash(path, "version-#{slug(name)}")
    FileUtils.mv("#{path}.bak", trashed) if File.exist?("#{path}.bak")
    puts "Deleted #{name} (moved to #{trashed})"
  end

  # ---------------------------------------------------------------------------
  # Core: loading and saving the context file
  # ---------------------------------------------------------------------------

  # Loads cid@vid into the repo. Whatever is loaded now is first saved to its
  # own chat@version, so switching never loses work.
  def switch_to(cid, vid)
    current = loaded_context
    if current && current["chat"] == cid && current["version"] == vid
      puts "#{label(cid, vid)} is already loaded"
      return
    end
    save_loaded(current) if current # raises on conflict, before anything changes

    exclude_context_dir_from_git
    # Remove the pointer before replacing the file. If mage crashes in between,
    # CONTEXT.md is left without a pointer and mage refuses to touch it, so
    # it can't be saved into the wrong version later.
    FileUtils.rm_f(pointer_file)
    content = File.binread(version_path(cid, vid))
    atomic_write(context_file, content)
    write_pointer(cid, vid, digest(content))

    puts "Loaded #{label(cid, vid)} into #{rel(context_file)}"
  end

  # Writes CONTEXT.md back to the chat@version named in the pointer.
  # Returns false when there was nothing to save.
  def save_loaded(ptr)
    cid = ptr["chat"]
    vid = ptr["version"]
    name = label(cid, vid)
    path = version_path(cid, vid)
    unless meta["chats"].dig(cid, "versions", vid) && File.exist?(path)
      raise MageError, "#{name} no longer exists in the store, so it can't be saved. " \
                       "Copy #{rel(context_file)} somewhere safe, then run `mage discard`"
    end

    stored = File.binread(path)
    content = File.binread(context_file)
    if content == stored
      write_pointer(cid, vid, digest(stored)) if digest(stored) != ptr["hash"]
      return false
    end
    if digest(stored) != ptr["hash"] && !@force
      raise MageError, "#{name} was changed elsewhere since it was loaded (another worktree or terminal?). " \
                       "Re-run with --force to overwrite it with #{rel(context_file)}"
    end

    atomic_write("#{path}.bak", stored) # one level of undo for each version
    atomic_write(path, content)
    write_pointer(cid, vid, digest(content))
    true
  end

  # Saves the loaded context, if any, and returns its pointer (or nil).
  def save_current!
    ptr = loaded_context
    save_loaded(ptr) if ptr
    ptr
  end

  # Returns the pointer of the loaded context, nil when nothing is loaded,
  # or raises when the repo is in a state mage can't handle safely.
  def loaded_context
    ptr = pointer
    has_file = File.exist?(context_file)
    return ptr if ptr && has_file
    return nil if ptr.nil? && !has_file

    if ptr
      raise MageError, "#{label(ptr['chat'], ptr['version'])} is loaded but #{rel(context_file)} is missing. " \
                       "Restore the file, or run `mage discard` to forget it"
    end
    raise MageError, "#{rel(context_file)} exists but mage doesn't know which chat it belongs to. " \
                     "Move it away, or run `mage discard` to move it to the trash"
  end

  def unsaved_changes?(ptr)
    return true if ptr.nil?

    path = version_path(ptr["chat"], ptr["version"])
    !File.exist?(path) || File.binread(path) != File.binread(context_file)
  end

  # Removes CONTEXT.md (if still there) and then the pointer.
  def unload!
    FileUtils.rm_f(context_file)
    FileUtils.rm_f(pointer_file)
    Dir.rmdir(context_dir) if Dir.exist?(context_dir) && Dir.empty?(context_dir)
  end

  def ensure_not_loaded!(cid)
    ptr = pointer
    return unless ptr && ptr["chat"] == cid

    raise MageError, "chat '#{meta['chats'][cid]['name']}' is loaded; switch to another chat or `mage quit` first"
  end

  def note_other_branch(ptr)
    name = meta["chats"].dig(ptr["chat"], "name")
    branch_name = current_branch
    return if branch_name.nil? || name == branch_name

    warn "note: loaded chat '#{name}' is not this branch's chat ('#{branch_name}')"
  end

  # ---------------------------------------------------------------------------
  # Metadata: chats and versions
  # ---------------------------------------------------------------------------

  def meta
    @meta ||= begin
      raise MageError, "this repo is not initialized; run `mage init`" unless File.exist?(meta_path)

      JSON.parse(File.read(meta_path))
    end
  end

  def save_meta!
    atomic_write(meta_path, JSON.pretty_generate(meta) + "\n")
  end

  def create_repo_store
    @meta = { "repo_path" => repo_root, "next_chat_id" => 1, "chats" => {} }
    save_meta!
    puts "Initialized repo store in #{store_dir}"
  end

  def create_chat(name)
    validate_name!(name, "chat")
    raise MageError, "chat '#{name}' already exists (load it: mage load #{name})" if chat_named(name)

    cid = "c#{meta['next_chat_id']}"
    meta["next_chat_id"] += 1
    meta["chats"][cid] = {
      "name" => name, "default" => nil, "next_version_id" => 1, "versions" => {}, "created_at" => now
    }
    vid = create_version(cid, nil, starter_content(name)) # also saves metadata
    puts "Created chat '#{name}' [#{cid}]"
    [cid, vid]
  end

  # A version without a name is named after its id, so labels read "main@v1".
  def create_version(cid, name, content)
    chat = meta["chats"][cid]
    vid = "v#{chat['next_version_id']}"
    if name
      validate_name!(name, "version")
      raise MageError, "chat '#{chat['name']}' already has a version '#{name}'" if chat["versions"].any? { |_, v| v["name"] == name }
    else
      name = vid
    end

    chat["next_version_id"] += 1
    # Write the file before the metadata: a crash in between only leaves an
    # orphan file, never metadata pointing at a missing file.
    atomic_write(version_path(cid, vid), content)
    chat["versions"][vid] = { "name" => name, "created_at" => now }
    chat["default"] = vid # new and forked versions become the default
    save_meta!
    vid
  end

  # nil or "__branch" means the current branch's chat.
  def find_chat(ref)
    from_branch = ref.nil? || ref == BRANCH
    ref = branch if from_branch
    return ref if meta["chats"].key?(ref)

    cid = chat_named(ref)
    return cid if cid
    raise MageError, "branch '#{ref}' has no chat yet; run `mage load` to create it" if from_branch

    raise MageError, "no chat '#{ref}' (see: mage chat list)"
  end

  # nil or "__default" means the chat's default version.
  def find_version(cid, ref)
    chat = meta["chats"][cid]
    ref = chat["default"] if ref.nil? || ref == DEFAULT
    return ref if chat["versions"].key?(ref)

    vid, = chat["versions"].find { |_, version| version["name"] == ref }
    vid or raise MageError, "chat '#{chat['name']}' has no version '#{ref}' (see: mage version list)"
  end

  # Version commands act on the loaded chat, or else on the branch's chat.
  def current_chat
    ptr = loaded_context
    ptr ? ptr["chat"] : find_chat(BRANCH)
  end

  def chat_named(name)
    cid, = meta["chats"].find { |_, chat| chat["name"] == name }
    cid
  end

  def validate_name!(name, kind)
    raise MageError, "missing #{kind} name" if name.nil? || name.strip.empty?
    return unless name.start_with?("__") || name.match?(/\A[cv]\d+\z/)

    raise MageError, "'#{name}' can't be used as a #{kind} name (names can't start with __ or look like an id such as c1 or v1)"
  end

  def label(cid, vid)
    chat = meta["chats"][cid]
    version = chat && chat["versions"][vid]
    "#{chat ? chat['name'] : cid}@#{version ? version['name'] : vid}"
  end

  def starter_content(chat_name)
    <<~MD
      # Context: #{chat_name}

      (Empty. Ask Claude to fill this in with the goal, decisions, progress and next steps.)
    MD
  end

  # ---------------------------------------------------------------------------
  # Paths, git and the file system
  # ---------------------------------------------------------------------------

  def config_path
    File.join(MAGE_HOME, "config.json")
  end

  def repo_key
    "#{File.basename(repo_root)}-#{Digest::SHA256.hexdigest(repo_root)[0, 8]}"
  end

  def store_dir
    File.join(MAGE_HOME, "repos", repo_key)
  end

  def meta_path
    File.join(store_dir, "mage.json")
  end

  def version_path(cid, vid)
    File.join(store_dir, "chats", cid, "#{vid}.md")
  end

  def context_dir
    File.join(repo_root, CONTEXT_DIR)
  end

  def context_file
    File.join(context_dir, "CONTEXT.md")
  end

  def pointer_file
    File.join(context_dir, "current.json")
  end

  def require_installed!
    raise MageError, "mage is not installed; run `mage install`" unless File.exist?(config_path)
  end

  def config
    @config ||= JSON.parse(File.read(config_path))
  end

  def pointer
    File.exist?(pointer_file) ? JSON.parse(File.read(pointer_file)) : nil
  end

  def write_pointer(cid, vid, hash)
    atomic_write(pointer_file, JSON.pretty_generate("chat" => cid, "version" => vid, "hash" => hash) + "\n")
  end

  def git(*cmd)
    out = IO.popen(["git", *cmd], err: File::NULL, &:read)
    $?.success? ? out.strip : nil
  end

  def repo_root
    @repo_root ||= git("rev-parse", "--show-toplevel") or raise MageError, "not inside a git repository"
  end

  def current_branch
    git("symbolic-ref", "--short", "HEAD")
  end

  def branch
    current_branch or raise MageError, "HEAD is detached, so there is no branch name; name the chat explicitly"
  end

  # Keeps .mage/ out of git without touching the shared .gitignore.
  def exclude_context_dir_from_git
    path = File.expand_path(git("rev-parse", "--git-path", "info/exclude"), repo_root)
    entry = "/#{CONTEXT_DIR}/"
    existing = File.exist?(path) ? File.read(path) : ""
    return if existing.lines.map(&:strip).include?(entry)

    separator = existing.empty? || existing.end_with?("\n") ? "" : "\n"
    atomic_write(path, "#{existing}#{separator}#{entry}\n")
  end

  # One mage command at a time per repo, so two terminals can't interleave writes.
  def with_repo_lock
    lock_path = File.join(MAGE_HOME, "repos", "#{repo_key}.lock")
    FileUtils.mkdir_p(File.dirname(lock_path))
    File.open(lock_path, File::RDWR | File::CREAT) do |lock|
      raise MageError, "another mage command is running for this repo" unless lock.flock(File::LOCK_EX | File::LOCK_NB)

      yield
    end
  end

  # Writes to a temp file next to the target and renames it into place, so the
  # target is always either the old or the new content, never half-written.
  def atomic_write(path, content)
    FileUtils.mkdir_p(File.dirname(path))
    tmp = "#{path}.tmp-#{Process.pid}"
    File.open(tmp, "wb") do |file|
      file.write(content)
      file.flush
      file.fsync
    end
    File.rename(tmp, path)
  ensure
    FileUtils.rm_f(tmp) if tmp
  end

  def move_to_trash(path, name)
    base = File.join(store_dir, "trash", "#{Time.now.strftime('%Y%m%d-%H%M%S')}-#{name}")
    dir = base
    counter = 1
    dir = "#{base}-#{counter += 1}" while File.exist?(dir)
    FileUtils.mkdir_p(dir)
    FileUtils.mv(path, dir)
    dir
  end

  # Runs the block with normal output discarded. Errors still reach the user,
  # since they are raised and printed by Mage.main.
  def quietly
    stdout = $stdout
    File.open(File::NULL, "w") do |null|
      $stdout = null
      yield
    end
  ensure
    $stdout = stdout
  end

  # Copies text with the first clipboard tool found (macOS, Wayland, X11).
  # Returns false instead of failing, since the clipboard is only a convenience.
  def copy_to_clipboard(text)
    tool = CLIPBOARD_TOOLS.find { |cmd| system("command -v #{cmd.first} >/dev/null 2>&1") }
    return false unless tool

    IO.popen(tool, "w", err: File::NULL) { |io| io.write(text) }
    $?.success?
  rescue SystemCallError
    false
  end

  def confirm!(question, default_yes: false)
    return if @force
    raise MageError, "#{question} Re-run with --force to confirm" unless $stdin.tty?

    print "#{question} #{default_yes ? '[Y/n]' : '[y/N]'} "
    answer = $stdin.gets.to_s.strip.downcase
    return if %w[y yes].include?(answer) || (default_yes && answer.empty?)

    raise MageError, "aborted"
  end

  def digest(content)
    Digest::SHA256.hexdigest(content)
  end

  def now
    Time.now.iso8601
  end

  def rel(path)
    path.delete_prefix("#{repo_root}/")
  end

  def slug(text)
    text.gsub(/[^\w.@-]+/, "_")
  end

  def print_table(header, rows)
    widths = header.each_index.map { |i| [header, *rows].map { |row| row[i].to_s.length }.max }
    [header, *rows].each do |row|
      puts row.each_with_index.map { |cell, i| cell.to_s.ljust(widths[i]) }.join("  ").rstrip
    end
  end

  # ---------------------------------------------------------------------------
  # Help
  # ---------------------------------------------------------------------------

  # The help text lives in help.txt next to the script (found through the
  # install symlink). {MAGE_HOME} and {CONTEXT_DIR} are filled in.
  def help_text
    raise MageError, "help file not found: #{HELP_FILE} (keep help.txt next to the script)" unless File.exist?(HELP_FILE)

    File.read(HELP_FILE).gsub("{MAGE_HOME}", MAGE_HOME).gsub("{CONTEXT_DIR}", CONTEXT_DIR)
  end
end

Mage.main(ARGV)
